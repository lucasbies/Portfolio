<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- SEO -->
    <meta name="description" content="{{#if meta.description}}{{meta.description}}{{else}}Lucas Bieszczad, développeur backend : Python, API, bases de données.{{/if}}">
    <meta name="author" content="Lucas Bieszczad">

    <!-- Open Graph -->
    <meta property="og:title" content="{{#if meta.title}}{{meta.title}}{{else}}Lucas Bieszczad | Développeur backend{{/if}}">
    <meta property="og:description" content="{{#if meta.description}}{{meta.description}}{{else}}Développeur backend : Python, API, bases de données.{{/if}}">
    <meta property="og:image" content="{{#if meta.image}}{{meta.image}}{{else}}https://lucasbies.github.io/Portfolio/assets/og-image.png{{/if}}">
    <meta property="og:url" content="{{#if meta.url}}{{meta.url}}{{else}}https://lucasbies.github.io/Portfolio/{{/if}}">
    <meta property="og:type" content="{{#if meta.type}}{{meta.type}}{{else}}website{{/if}}">
    <meta property="og:locale" content="fr_FR">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{#if meta.title}}{{meta.title}}{{else}}Lucas Bieszczad | Développeur backend{{/if}}">
    <meta name="twitter:description" content="{{#if meta.description}}{{meta.description}}{{else}}Développeur backend : Python, API, bases de données.{{/if}}">
    <meta name="twitter:image" content="{{#if meta.image}}{{meta.image}}{{else}}https://lucasbies.github.io/Portfolio/assets/og-image.png{{/if}}">

    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{#if meta.url}}{{meta.url}}{{else}}https://lucasbies.github.io/Portfolio/{{/if}}">
    {{#if meta.jsonld}}<script type="application/ld+json">{{{meta.jsonld}}}</script>{{/if}}

    <!-- Favicons -->
    <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="assets/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="assets/apple-touch-icon.png">
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico">
    <link rel="manifest" href="assets/site.webmanifest">
    <meta name="theme-color" content="#EEF1F4" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0E1626" media="(prefers-color-scheme: dark)">

    <title>{{#if meta.title}}{{meta.title}}{{else}}Lucas Bieszczad | Développeur backend{{/if}}</title>

    <!-- Thème appliqué avant le rendu (évite le flash clair/sombre) -->
    <script>
        try {
            var t = localStorage.getItem('theme');
            if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
    </script>

    <!-- IBM Plex : Sans (texte), Sans Condensed (titres), Mono (requêtes, routes, code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap">

    <link rel="stylesheet" href="assets/style.css">
    <script src="assets/script.js" defer></script>
</head>
<body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    {{> header }}
    {{{ body }}}
    {{> footer }}
</body>
</html>
