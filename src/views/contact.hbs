<main id="contenu">

<header class="page-head">
    <h1>Contact</h1>
    <p class="lede">
        Pour une question sur un projet ou sur mon parcours, écrivez-moi.
        Je réponds sous 48h.
    </p>
</header>

<section class="section">
    <div class="contact-grid">
        <div>
            <h2>Envoyer un message</h2>
            <form action="https://formspree.io/f/mqadvrkl" method="POST" class="form">
                <div class="field">
                    <label for="contact-name">Nom</label>
                    <input type="text" id="contact-name" name="name" autocomplete="name" required>
                </div>
                <div class="field">
                    <label for="contact-email">Email</label>
                    <input type="email" id="contact-email" name="email" autocomplete="email" required>
                </div>
                <div class="field">
                    <label for="contact-message">Message</label>
                    <textarea id="contact-message" name="message" rows="6" maxlength="500" aria-describedby="contact-count" required></textarea>
                    <small id="contact-count" class="char-count">500 caractères maximum</small>
                </div>
                <button type="submit" class="btn btn-primary">Envoyer le message</button>
            </form>
        </div>

        <aside aria-labelledby="titre-direct">
            <h2 id="titre-direct">En direct</h2>
            <ul class="direct">
                <li><span>Email</span><a href="mailto:lucasbieszczad@gmail.com">lucasbieszczad@gmail.com</a></li>
                <li><span>GitHub</span><a href="https://github.com/lucasbies" target="_blank" rel="noopener">github.com/lucasbies</a></li>
                <li><span>LinkedIn</span><a href="https://www.linkedin.com/in/lucas-bieszczad/" target="_blank" rel="noopener">linkedin.com/in/lucas-bieszczad</a></li>
                <li><span>CV</span><a href="assets/cv.pdf" download>Télécharger le CV (PDF)</a></li>
                <li><span>Localisation</span>France, disponible à distance</li>
            </ul>
        </aside>
    </div>
</section>

</main>
