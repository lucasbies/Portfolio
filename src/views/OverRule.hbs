                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                    </svg>
                    Voir sur GitHub
                </a>
            </div>
            <pre><code><span class="keyword">private</span> <span class="type">IEnumerator</span> <span class="function">GestionScores</span>(<span class="keyword">int</span>[] scoresCibles)
{
    <span class="keyword">yield return new</span> <span class="type">WaitForSeconds</span>(<span class="number">1f</span>);
    <span class="keyword">yield return</span> <span class="function">StartCoroutine</span>(<span class="function">DefileScore</span>(scoresCibles, <span class="number">1.5f</span>));
    <span class="comment">// Attendre que tout le monde soit prêt</span>
    <span class="keyword">yield return</span> <span class="function">StartCoroutine</span>(<span class="function">SystemePret</span>());
    <span class="keyword">yield return new</span> <span class="type">WaitForSeconds</span>(<span class="number">1f</span>);
    
    <span class="comment">// Gestion des jokers</span>
    <span class="keyword">for</span> (<span class="keyword">int</span> i = <span class="number">0</span>; i < jockerList.<span class="function">Count</span>; i++)
    {
        <span class="comment">// Calcul du score avec le joker en cours</span>
        <span class="type">List</span>&lt;<span class="type">PlayerTemp</span>&gt; listTemp = jockerList[i].<span class="function">UtilisationJoker</span>();
        
        <span class="comment">// Mise à jour scores cibles</span>
        <span class="keyword">for</span> (<span class="keyword">int</span> j = <span class="number">0</span>; j < nbJoueur; j++)
            <span class="keyword">foreach</span> (<span class="keyword">var</span> temp <span class="keyword">in</span> listTemp)
                <span class="keyword">if</span> (playerListAjout[j].clientId == (<span class="keyword">ulong</span>)temp.clientId)
                    scoresCibles[j] = temp.score;
        
        <span class="comment">// Animation joker</span>
        <span class="keyword">bool</span> isMystery = jockerList[i].mystere;
        <span class="keyword">if</span> (isMystery)
            jokerImage.sprite = config.mystereSprite;
        <span class="keyword">else</span>
            jokerImage.sprite = config.jokers[jockerList[i].priorite].sprite;
        
        <span class="keyword">yield return</span> <span class="function">StartCoroutine</span>(<span class="function">DefileScore</span>(scoresCibles, <span class="number">2f</span>));
        <span class="keyword">yield return</span> <span class="function">StartCoroutine</span>(<span class="function">SystemePret</span>());
        <span class="keyword">yield return new</span> <span class="type">WaitForSeconds</span>(<span class="number">0.2f</span>);
    }
    
    <span class="comment">// Mise à jour serveur</span>
    <span class="keyword">if</span> (NetworkManager.Singleton.IsServer)
    {
        <span class="keyword">for</span> (<span class="keyword">int</span> i = <span class="number">0</span>; i < nbJoueur; i++)
        {
            <span class="keyword">for</span> (<span class="keyword">int</span> j = <span class="number">0</span>; j < nbJoueur; j++)
            {
                <span class="keyword">if</span> (playerListAjout[i].clientId == playerList[j].clientId)
                {
                    <span class="keyword">var</span> temp = playerList[j];
                    playerList.<span class="function">RemoveAt</span>(j);
                    temp.score = scoreActuel[i];
                    playerList.<span class="function">Insert</span>(j, temp);
                }
            }
        }
        
        PlayerData.Instance.<span class="function">ResetPlayerListsAjout</span>();
        jockerList.<span class="function">Clear</span>();
        skipButton.gameObject.<span class="function">SetActive</span>(<span class="keyword">true</span>);
    }
}</code></pre>
