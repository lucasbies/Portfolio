    <!-- Défis techniques (BREAKDOWN) -->
    <section class="project-section" id="breakdown">
        <h2>Défis techniques rencontrés</h2>
        <div class="challenges-grid">
            
            <article class="challenge-card">
                <div class="challenge-header">
                    <span class="challenge-number">01</span>
                    <h3>Synchronisation état de jeu</h3>
                </div>
                <div class="challenge-content">
                    <p>
                        Synchroniser les mouvements, actions et états des joueurs sur le réseau 
                        sans lag perceptible ni désynchronisation.
                    </p>
                    <h4>Solution en cours</h4>
                    <p>
                        Utilisation de <strong>NetworkVariables</strong> pour état partagé, 
                        <strong>ClientRPC</strong> pour événements visuels, et interpolation pour mouvements fluides.
                    </p>
                </div>
            </article>

            <article class="challenge-card">
                <div class="challenge-header">
                    <span class="challenge-number">02</span>
                    <h3>Gestion lobby & matchmaking</h3>
                </div>
                <div class="challenge-content">
                    <p>
                        Créer un système de lobby permettant aux joueurs de rejoindre/quitter 
                        une partie avant le début du match.
                    </p>
                    <h4>Solution prévue</h4>
                    <p>
                        Intégration <strong>Unity Lobby Service</strong> + <strong>Relay</strong> 
                        pour hébergement sans serveur dédié (approche peer-to-peer sécurisée).
                    </p>
                </div>
            </article>

            <article class="challenge-card">
                <div class="challenge-header">
                    <span class="challenge-number">03</span>
                    <h3>Équilibrage gameplay multijoueur</h3>
                </div>
                <div class="challenge-content">
                    <p>
                        Concevoir des mécaniques équitables en mode coopératif ET compétitif, 
                        avec gestion des latences variables.
                    </p>
                    <h4>Approche adoptée</h4>
                    <p>
                        Phases de playtests régulières en équipe, ajustement des timings 
                        et compensation lag côté serveur (prédiction client + réconciliation).
                    </p>
                </div>
            </article>

        </div>
    </section>

