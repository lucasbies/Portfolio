    <!-- Défis techniques -->
    <section class="project-section">
        <h2>Défis techniques rencontrés</h2>
        <div class="challenges-grid">
            <article class="challenge-card">
                <div class="challenge-header">
                    <span class="challenge-number">01</span>
                    <h3>Rendu ASCII multi-plateforme</h3>
                </div>
                <div class="challenge-content">
                    <p>
                        La console Windows gère mal certains caractères UTF-8, rendant les symboles ♠♥♦♣ illisibles.
                    </p>
                    <h4>Solution adoptée</h4>
                    <p>
                        Détection de l'OS au runtime avec préprocesseur et fallback ASCII pour compatibilité.
                    </p>
                </div>
            </article>

            <article class="challenge-card">
                <div class="challenge-header">
                    <span class="challenge-number">02</span>
                    <h3>Architecture POO et règles Klondike</h3>
                </div>
                <div class="challenge-content">
                    <p>
                        Structurer le projet avec classes séparées : <strong>CGame</strong> (boucle principale), 
                        <strong>CPlateau</strong> (état de jeu + règles), <strong>CCarte</strong> (données individuelles).
                    </p>
                    <h4>Solution adoptée</h4>
                    <p>
                        Architecture modulaire avec fichiers .h/.cpp séparés, utilisation de <code>std::vector</code> 
                        pour colonnes/pioche, surcharge de l'opérateur <code>&lt;&lt;</code> pour l'affichage.
                    </p>
                </div>
            </article>
        </div>
    </section>

